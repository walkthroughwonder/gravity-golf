# Server-only configuration. Do not put real credentials in source or chat.
# Keep disabled until a separate test project and Stripe test mode are ready.
GG_COMMERCE_MODE=disabled
GG_SITE_ORIGIN=http://localhost:8888
GG_FIREBASE_PROJECT_ID=
# Public Firebase web app config for the SAME environment. These two values are
# intentionally returned by /api/commerce/status; the service account is not.
GG_FIREBASE_WEB_API_KEY=
GG_FIREBASE_WEB_APP_ID=
GG_FIREBASE_SERVICE_ACCOUNT_JSON=
GG_STRIPE_PRICE_ID=
GG_STRIPE_SECRET_KEY=
GG_STRIPE_WEBHOOK_SECRET=

# Firebase Admin 14 / jwks-rsa 4 needs this in Netlify's Node Functions runtime.
# For a future approved deploy, set it in Functions scope, not only build scope.
NODE_OPTIONS=--experimental-require-module

# Public BUILD configuration for optional, opt-in GA4 funnel measurement.
# Never set REVIEWED until privacy copy and GA4 property settings are reviewed.
GG_ANALYTICS_MODE=disabled
GG_ANALYTICS_REVIEWED=no
GG_ANALYTICS_ORIGIN=
GG_GA4_LIVE_ID=
GG_GA4_TEST_ID=
